{
  "name": "@cycjimmy/h5-pages",
  "type": "module",
  "version": "5.0.0",
  "description": "full h5 page plugin based on swiper",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/h5-pages#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/h5-pages.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/h5-pages/issues"
  },
  "keywords": [
    "full",
    "h5",
    "page",
    "swiper"
  ],
  "browser": "dist/h5-pages.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/h5-pages.esm.js",
      "default": "./dist/h5-pages.esm.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/h5-pages.esm.js",
  "module": "dist/h5-pages.esm.js",
  "unpkg": "dist/h5-pages.umd.min.js",
  "jsdelivr": "dist/h5-pages.umd.min.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "dev": "vite",
    "build": "node tasks/clean.ts dist && npm run build:types && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment",
    "package": "node tasks/clean.ts .release && npm run build && node tasks/copyFiles.ts && node tasks/handlePackageJson.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/awesome-js-funcs": "^5.0.0",
    "@cycjimmy/config-lib": "^4.0.0",
    "@cycjimmy/sass-lib": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.13.0",
    "fs-extra": "^11.2.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "sass": "^1.106.0",
    "stylelint": "^18.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "swiper": "^14.4.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "stylelint-order": "^8.1.3"
  }
}
